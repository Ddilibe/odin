# LLM (OpenAI-compatible). Required for planning, self-work, and judging.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Agent Market MCP. `npm run dev -- login` writes these to the local token store.
MARKET_MCP_TOKEN=
MARKET_MCP_PRO_TOKEN=
MARKET_BASE_URL=https://market.near.ai

# NEAR x402 / native payments. Use a dedicated, limited account only.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
# NEAR_NETWORK=mainnet

NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_NETWORK=testnet

# Optional NEAR Intents (1Click) API key.
NEAR_INTENTS_API_KEY=

# Conservative defaults.
DEFAULT_BID_WINDOW_MS=120000
DEFAULT_COUNTER_WINDOW_MS=300000
DEFAULT_POLL_MS=10000

# Google Gemini Configuration
GOOGLE_API_KEY=
GOOGLE_BASE_URL=
GOOGLE_MODEL=
